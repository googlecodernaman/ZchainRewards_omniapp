# Environment Variables Template
# Copy this to .env and fill in your values

# Private Keys (DO NOT COMMIT REAL KEYS)
PRIVATE_KEY_ADMIN=your_admin_private_key_here
PRIVATE_KEY_RECIPIENT=your_recipient_private_key_here

# RPC URLs
ZETACHAIN_TESTNET_RPC=https://zetachain-athens-evm.blockpi.network/v1/rpc/public
POLYGON_MUMBAI_RPC=https://rpc-mumbai.maticvigil.com
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545

# Explorer API Keys (optional)
POLYGONSCAN_API_KEY=your_polygonscan_api_key
BSCSCAN_API_KEY=your_bscscan_api_key

# Oracle Configuration
ORACLE_STALENESS_THRESHOLD=3600
ORACLE_DEVIATION_THRESHOLD=500

# Debug
DEBUG=true
VERBOSE_LOGS=true
